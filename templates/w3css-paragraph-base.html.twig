{#
/**
 * @file
 * Shared wrapper that every w3css_* paragraph template extends.
 *
 * Use it from any module or theme with:
 * {% extends '@w3css_paragraphs/w3css-paragraph-base.html.twig' %}
 *
 * The file name does not start with "paragraph--", so the theme registry
 * never picks it as a template suggestion; it is only reached through
 * the @w3css_paragraphs Twig namespace.
 *
 * Variables built once in PHP (W3cssPreprocessHooks::addDisplayVariables):
 * - w3css_display: display option values keyed by field name without the
 *   w3css_display_ prefix, for example w3css_display.round.
 * - w3css_wrapper_classes: base paragraph classes plus the width class.
 * - w3css_class_groups: lists of option classes, keyed box, spacing, text
 *   and frame.
 * - The older per-field names (w3css_round, w3css_margin, container_width
 *   and the rest) for templates copied from earlier releases.
 *
 * Settings a child template may set before the parent renders:
 * - w3css_id_prefix: prefix of the paragraph id; default "w3-default-".
 * - w3css_wrapper_box: false keeps the box group off the outer wrapper.
 * - w3css_id_on_wrapper: true puts the paragraph id on the outer wrapper,
 *   after its other attributes; 'first' prints it before them.
 * - w3css_wrapper_extra: more classes for the outer wrapper, added last.
 * - w3css_inner_id: false prints the inner wrapper without the paragraph id
 *   (for bundles that put the id on an element inside w3css_content).
 *
 * Blocks:
 * - w3css_libraries: extra attach_library() calls.
 * - w3css_inner: everything inside the outer wrapper.
 * - w3css_content: the children inside the inner and spacing wrappers.
 *
 * Variables set here for the blocks: classes, paragraph_id,
 * w3css_margin_padding, w3css_link, w3css_link_title_attr.
 */
#}
{{ attach_library('w3css_paragraphs/w3css-paragraphs') }}
{% block w3css_libraries %}{% endblock %}

{% set classes = w3css_wrapper_box is same as(false)
  ? w3css_wrapper_classes
  : w3css_wrapper_classes|merge(w3css_class_groups.box) %}
{% set classes = classes|merge(w3css_wrapper_extra|default([])) %}
{% set paragraph_id = (w3css_id_prefix|default('w3-default-')) ~ paragraph.id.value %}
{% set w3css_margin_padding = w3css_class_groups.spacing|join(' ') %}

{# The link field is shared by most bundles; read it in one place. #}
{% set w3css_link = null %}
{% set w3css_link_title_attr = null %}
{% if content.w3css_content_link|render is not empty %}
  {% set w3css_link = content.w3css_content_link.0['#url'] %}
  {% if content.w3css_content_link_title_attr|render|striptags|trim %}
    {% set w3css_link_title_attr = content.w3css_content_link_title_attr|render|striptags|trim %}
  {% endif %}
{% endif %}

{# The background color comes from a dynamic library; see W3cssDynamicCssHooks. #}
{% if w3css_id_on_wrapper is same as('first') %}
<div id="{{ paragraph_id }}" {{ attributes.addClass(classes) }}>
{% else %}
<div {{ w3css_id_on_wrapper ? attributes.addClass(classes).setAttribute('id', paragraph_id) : attributes.addClass(classes) }}>
{% endif %}
{% block w3css_inner %}
  <div {% if w3css_inner_id is not same as(false) %}id="{{ paragraph_id }}" {% endif %}class="w3-row p-container-inner">

    {% if w3css_margin_padding %}
    <div class="w3-row {{ w3css_margin_padding }}">
    {% endif %}
      {% block w3css_content %}{% endblock %}
    {% if w3css_margin_padding %}
    </div>
    {% endif %}

  </div>
{% endblock %}
</div> {# End of main wrapper #}
