 * Primary module hooks for W3CSS Paragraphs Responsive Image.
 */

declare(strict_types=1);

/**
 * @file
 * W3CSS Paragraphs Responsive Image.
 *
 * Filename:     w3css_paragraphs_responsive_image.module
 * Website:      https://www.flashwebcenter.com
