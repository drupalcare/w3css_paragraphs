use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\w3css_paragraphs_responsive_image\Hook\W3cssParagraphsResponsiveImageHooks;
use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function w3css_paragraphs_responsive_image_help($route_name, RouteMatchInterface $route_match) {
  return \Drupal::service(W3cssParagraphsResponsiveImageHooks::class)->help($route_name, $route_match);
}

/**
 * Implements hook_theme().
 */
#[LegacyHook]
function w3css_paragraphs_responsive_image_theme($existing, $type, $theme, $path) {
  return \Drupal::service(W3cssParagraphsResponsiveImageHooks::class)->theme($existing, $type, $theme, $path);
}
