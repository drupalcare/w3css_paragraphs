<?php

/**
 * @file
 * Install, update and uninstall hooks for W3CSS Paragraphs Image Overlay.
 */

declare(strict_types=1);

/**
 * @file
 * Install, uninstall and update hooks for W3CSS Paragraphs module.
 */

use Drupal\Component\Utility\NestedArray;
use Drupal\Component\Serialization\Yaml;
use Drupal\Core\Config\Entity\ConfigEntityStorageInterface;
use Drupal\Core\Config\Entity\ConfigEntityTypeInterface;
use Drupal\Core\Config\FileStorage;
use Drupal\Core\Entity\Display\EntityDisplayInterface;

/**
 * Updates a configuration from yml file.
 *
 * @param string $ymlFileName
 *   Yml file name (without .yml suffix).
 * @param string $entityType
 *   The display entity type ID.
 * @param string $id
 *   The display entity ID.
 * @param array<string, string> $setComponents
 *   An array of what needs to be set.
 *   - The key will be what we are setting (Can have . in string for array).
 *   - The value is the key that will be used from the new config file (Can have
 *    . in string for array).
 */
function _w3css_paragraphs_image_overlay_update_entity_from_yml(string $ymlFileName, string $entityType, string $id, array $setComponents): void {
  $w3css_path = \Drupal::service('extension.list.module')->getPath('w3css_paragraphs_image_overlay');
  $yml        = Yaml::decode((string) file_get_contents($w3css_path . '/config/optional/' . $ymlFileName . '.yml'));
  $entity     = \Drupal::entityTypeManager()->getStorage($entityType)->load($id);
  if (!$entity instanceof EntityDisplayInterface) {
    return;
  }
  foreach ($setComponents as $key => $value) {
    $parts = explode('.', $value);
    if (count($parts) == 1) {
      $entity->setComponent($key, $yml[$value]);
    }
    else {
      $value = NestedArray::getValue($yml, $parts);
      $entity->setComponent($key, $value);
    }
  }
  $entity->save();
}

/**
 * Create the fields from the yml file.
 *
 * @param string $moduleName
 *   Yml file name (without .yml suffix).
 * @param list<string> $newFields
 *   An array of what needs to be set.
 */
function _w3css_paragraphs_image_overlay_update_fields_from_yml(string $moduleName, array $newFields): void {
  $module_handler = \Drupal::moduleHandler();
  $config_storage = new FileStorage(
    $module_handler->getModule($moduleName)->getPath() . '/config/optional'
  );
  foreach ($newFields as $config_name) {
    $config_record = $config_storage->read($config_name);
    // The shipped YAML can be absent on a partial checkout. Skipping is right
    // here: aborting would take every later update with it.
    if ($config_record === FALSE) {
      continue;
    }
    $entity_type = \Drupal::service('config.manager')->getEntityTypeIdByName($config_name);
    if ($entity_type === NULL) {
      continue;
    }
    $entity_type_manager = \Drupal::entityTypeManager();
    $storage = $entity_type_manager->getStorage($entity_type);
    $definition = $entity_type_manager->getDefinition($entity_type);
    if (!$storage instanceof ConfigEntityStorageInterface || !$definition instanceof ConfigEntityTypeInterface) {
      continue;
    }
    // AN UPDATE HOOK MUST BE RE-RUNNABLE, and this one was not.
    // createFromStorageRecord() always builds a NEW entity, so save() throws
    // EntityStorageException "'...' entity with ID '...' already exists" the
    // moment the config is already present -- which it is on every site where
    // config/optional installed it, i.e. every correctly installed site.
    // One throw aborts the ENTIRE update run, including other modules'.
    $id = $storage::getIDFromConfigName(
      $config_name,
      $definition->getConfigPrefix()
    );
    if ($storage->load($id) !== NULL) {
      continue;
    }
    $entity = $storage->createFromStorageRecord($config_record);
    $entity->save();
  }
}

/**
 * Update third party configuration from yml file.
 */
function _w3css_paragraphs_image_overlay_update_third_party_from_yml(string $entityType, string $id, string $moduleName, string $key): void {
  $w3css_recent_config = \Drupal::entityTypeManager()
    ->getStorage($entityType)
    ->load($id);
  if (!$w3css_recent_config instanceof EntityDisplayInterface) {
    return;
  }
  $fg_settings = $w3css_recent_config->getThirdPartySetting($moduleName, $key);
  if (empty($fg_settings)) {
    return;
  }
  else {
    // Add each child once: this helper must be re-runnable, and a repeated run
    // used to append a duplicate entry.
    $children = $fg_settings['children'] ?? [];
    $added = FALSE;
    foreach (['w3css_content_link_title_attr'] as $child) {
      if (!in_array($child, $children, TRUE)) {
        $children[] = $child;
        $added = TRUE;
      }
    }
    if (!$added) {
      return;
    }
    $fg_settings['children'] = $children;
    $w3css_recent_config->setThirdPartySetting($moduleName, $key, $fg_settings);
    $w3css_recent_config->save();
  }
}

/**
 * Implements hook_update_N().
 */
function w3css_paragraphs_image_overlay_update_9001(): void {

  _w3css_paragraphs_image_overlay_update_fields_from_yml('w3css_paragraphs_image_overlay',
    [
      'field.field.paragraph.w3css_image_overlay.w3css_content_link_title_attr',
    ]
  );
}

/**
 * Implements hook_update_N().
 */
function w3css_paragraphs_image_overlay_update_9002(): void {

  _w3css_paragraphs_image_overlay_update_entity_from_yml(
        'core.entity_form_display.paragraph.w3css_image_overlay.default',
        'entity_form_display',
        'paragraph.w3css_image_overlay.default',
        [
          'w3css_display_border'           => 'content.w3css_display_border',
          'w3css_display_opacity'          => 'content.w3css_display_opacity',
          'w3css_display_bg_color'         => 'content.w3css_display_bg_color',
          'w3css_display_border_color'     => 'content.w3css_display_border_color',
          'w3css_display_card'             => 'content.w3css_display_card',
          'w3css_content_title'            => 'content.w3css_content_title',
          'w3css_content_image'            => 'content.w3css_content_image',
          'w3css_display_image_overlay'    => 'content.w3css_display_image_overlay',
          'w3css_content_link'             => 'content.w3css_content_link',
          'w3css_content_link_title_attr'  => 'content.w3css_content_link_title_attr',
          'w3css_display_margin'           => 'content.w3css_display_margin',
          'w3css_display_padding'          => 'content.w3css_display_padding',
          'w3css_display_round'            => 'content.w3css_display_round',
          'w3css_display_text_color'       => 'content.w3css_display_text_color',
          'w3css_display_width'            => 'content.w3css_display_width',
        ]
    );

}

/**
 * Implements hook_update_N().
 */
function w3css_paragraphs_image_overlay_update_9003(): void {

  _w3css_paragraphs_image_overlay_update_entity_from_yml(
        'core.entity_view_display.paragraph.w3css_image_overlay.default',
        'entity_view_display',
        'paragraph.w3css_image_overlay.default',
        [
          'w3css_display_border'           => 'content.w3css_display_border',
          'w3css_display_opacity'          => 'content.w3css_display_opacity',
          'w3css_display_bg_color'         => 'content.w3css_display_bg_color',
          'w3css_display_border_color'     => 'content.w3css_display_border_color',
          'w3css_display_card'             => 'content.w3css_display_card',
          'w3css_content_title'            => 'content.w3css_content_title',
          'w3css_content_image'            => 'content.w3css_content_image',
          'w3css_display_image_overlay'    => 'content.w3css_display_image_overlay',
          'w3css_content_link'             => 'content.w3css_content_link',
          'w3css_content_link_title_attr'  => 'content.w3css_content_link_title_attr',
          'w3css_display_margin'           => 'content.w3css_display_margin',
          'w3css_display_padding'          => 'content.w3css_display_padding',
          'w3css_display_round'            => 'content.w3css_display_round',
          'w3css_display_text_color'       => 'content.w3css_display_text_color',
          'w3css_display_width'            => 'content.w3css_display_width',
        ]
    );
}

/**
 * Implements hook_update_N().
 */
function w3css_paragraphs_image_overlay_update_9004(): void {
  _w3css_paragraphs_image_overlay_update_third_party_from_yml('entity_form_display',
    'paragraph.w3css_image_overlay.default', 'field_group', 'w3css_tab_content');
  \Drupal::messenger()->addMessage('A new field was added for link title attribute.');
}
