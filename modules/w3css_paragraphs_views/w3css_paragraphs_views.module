use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\w3css_paragraphs_views\Hook\W3cssParagraphsViewsHooks;
use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function w3css_paragraphs_views_help($route_name, RouteMatchInterface $route_match) {
  return \Drupal::service(W3cssParagraphsViewsHooks::class)->help($route_name, $route_match);
}
