{#
/**
 * @file
 * Theme implementation for the w3css_image_overlay paragraph.
 *
 * Extends the shared wrapper; see w3css-paragraph-base.html.twig for the
 * variables built in PHP and the blocks a child can fill.
 *
 * Available variables:
 * - paragraph: Full paragraph entity.
 * - content: All paragraph items.
 * - attributes: HTML attributes for the containing element.
 * - view_mode: View mode; for example, "preview" or "full".
 * - content_title_tag: Heading element for the content title.
 * - w3css_element_id: Optional element id prefix.
 * - w3css_image_overlay: The overlay class, for example
 *   "w3-image-overlay-title".
 * - w3css_link, w3css_link_title_attr: The link field, set by the base.
 *
 * @see template_preprocess_paragraph()
 * @see \Drupal\w3css_paragraphs\Hook\W3cssPreprocessHooks
 *
 * @ingroup themeable
 */
#}
{% extends '@w3css_paragraphs/w3css-paragraph-base.html.twig' %}

{% set w3css_id_prefix = 'w3-image-overlay-' %}
{% set w3css_wrapper_box = false %}
{% set w3css_id_on_wrapper = true %}
{% set w3css_image_overlay = w3css_display.image_overlay is defined ? 'w3-image-overlay-' ~ w3css_display.image_overlay : '' %}
{% set w3css_wrapper_extra = [w3css_image_overlay, w3css_display.round|default('')]|filter(c => c != '') %}

{% block w3css_libraries %}
{{ attach_library('w3css_paragraphs_image_overlay/w3css-paragraphs-image-overlay') }}
{% endblock %}

{% block w3css_inner %}
{% set w3css_txt_classes = w3css_class_groups.overlay_text|join(' ') %}
{% set w3css_image_classes = w3css_class_groups.overlay_frame|join(' ') %}
{% if content.w3css_content_image|render is not empty %}
  {% set w3css_image = content.w3css_content_image %}
{% endif %}
  <div class="w3-row p-container-inner w3-display-container{{ w3css_image_classes == '' ? '' : ' ' ~ w3css_image_classes }}">

    <div class="w3-row w3-img-wrapper{{ w3css_round == '' ? '' : ' ' ~ w3css_round }}">{{ w3css_image }}</div>

    <div {% if w3css_element_id %}id="{{ w3css_element_id }}--overlay" {% endif %}class="w3-row overlay-container{{ w3css_txt_classes == '' ? '' : ' ' ~ w3css_txt_classes }}">

      {% if w3css_link %}
      <a href="{{ w3css_link }}" class="w3-row w3css-link" {% if w3css_link_title_attr %} title="{{ w3css_link_title_attr }}" {% endif %}>
      {% endif %}

        <div class="w3-row">
          {% if content.w3css_content_title|render %}
          <{{ content_title_tag }} {% if w3css_image_overlay == 'w3-image-overlay-title' and w3css_element_id %}id="{{ w3css_element_id }}--title" {% endif %}class="content-title overlay-title {{ w3css_margin_padding == '' ? '' : ' ' ~ w3css_margin_padding }}">
            {{ content.w3css_content_title }}
          </{{ content_title_tag }}>
          {% endif %}
        </div>

      {% if w3css_link %}
      </a>
      {% endif %}
    </div>

  </div>
{% endblock %}
