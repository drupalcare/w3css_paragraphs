use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\w3css_paragraphs_content\Hook\W3cssParagraphsContentHooks;
use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function w3css_paragraphs_content_help($route_name, RouteMatchInterface $route_match) {
  return \Drupal::service(W3cssParagraphsContentHooks::class)->help($route_name, $route_match);
}

/**
 * Implements hook_theme().
 */
// Function w3css_paragraphs_content_theme($existing, $type, $theme, $path) {
