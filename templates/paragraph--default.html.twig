{#
/**
 * @file
 * Default theme implementation to display a paragraph.
 *
 * Extends the shared wrapper; see w3css-paragraph-base.html.twig for the
 * variables built in PHP and the blocks a child can fill.
 *
 * Available variables:
 * - paragraph: Full paragraph entity.
 * - content: All paragraph items. Use {{ content }} to print them all,
 *   or print a subset such as {{ content.field_example }}.
 * - attributes: HTML attributes for the containing element.
 * - view_mode: View mode; for example, "preview" or "full".
 * - content_title_tag: Heading element for the content title.
 * - logged_in: Flag for authenticated user status.
 * - is_admin: Flag for admin user status.
 *
 * @see template_preprocess_paragraph()
 * @see \Drupal\w3css_paragraphs\Hook\W3cssPreprocessHooks
 *
 * @ingroup themeable
 */
#}
{% extends '@w3css_paragraphs/w3css-paragraph-base.html.twig' %}

{% block w3css_content %}
      {% if content.w3css_content_title|render %}
      <{{ content_title_tag }} class="content-title">{{ content.w3css_content_title }}</{{ content_title_tag }}>
      {% endif %}
      {# In the default template we remove un wanted fields #}
      {{ content|without('w3css_display_border', 'w3css_display_bg_color', 'w3css_display_opacity', 'w3css_display_border_color', 'w3css_display_card', 'w3css_display_hover_bg', 'w3css_display_hover_border', 'w3css_display_hover_text', 'w3css_display_margin', 'w3css_display_padding', 'w3css_display_round', 'w3css_display_text_color', 'w3css_display_width', 'w3css_display_classes', 'w3css_content_title') }}
{% endblock %}
