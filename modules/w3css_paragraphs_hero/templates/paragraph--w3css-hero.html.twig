{#
/**
 * @file
 * Theme implementation for the w3css_hero paragraph.
 *
 * Extends the shared wrapper; see w3css-paragraph-base.html.twig for the
 * variables built in PHP and the blocks a child can fill.
 *
 * Available variables:
 * - paragraph: Full paragraph entity.
 * - content: All paragraph items.
 * - attributes: HTML attributes for the containing element.
 * - view_mode: View mode; for example, "preview" or "full".
 * - content_title_tag: Heading element for the content title.
 * - w3css_element_id: Optional element id prefix.
 * - w3css_link, w3css_link_title_attr: The link field, set by the base.
 *
 * @see template_preprocess_paragraph()
 * @see \Drupal\w3css_paragraphs\Hook\W3cssPreprocessHooks
 *
 * @ingroup themeable
 */
#}
{% extends '@w3css_paragraphs/w3css-paragraph-base.html.twig' %}

{% set w3css_id_prefix = 'w3-hero-' %}
{% set w3css_wrapper_box = false %}
{% set w3css_id_on_wrapper = true %}

{% block w3css_libraries %}
{{ attach_library('w3css_paragraphs_hero/w3css-paragraphs-hero') }}
{% endblock %}

{% block w3css_inner %}
{% set w3css_txt_classes = w3css_class_groups.hero_text|join(' ') %}
{% set w3css_image_classes = w3css_class_groups.frame|join(' ') %}
{% if content.w3css_content_image|render is not empty %}
  {% set w3css_image = content.w3css_content_image %}
{% endif %}
  <div class="w3-row p-container-inner w3-display-container{{ w3css_image_classes == '' ? '' : ' ' ~ w3css_image_classes }}">

    <div class="w3-row w3-img-wrapper{{ w3css_round == '' ? '' : ' ' ~ w3css_round }}">
      {{ w3css_image }}
    </div>

    <div class="w3-row w3-hero-txt-wrapper{{ w3css_round == '' ? '' : ' ' ~ w3css_round }}">
      {% if w3css_link %}
      <a href="{{ w3css_link }}" class="w3-row w3css-link" {% if w3css_link_title_attr %} title="{{ w3css_link_title_attr }}" {% endif %}>
      {% endif %}
        <div {% if w3css_element_id %}id="{{ w3css_element_id }}--inner" {% endif %} class="w3-hero-txt-wrapper-inner {{ w3css_txt_classes == '' ? '' : ' ' ~ w3css_txt_classes }}">

          {% if content.w3css_content_title|render %}
            <{{ content_title_tag }} class="content-title">{{ content.w3css_content_title }}</{{ content_title_tag }}>
          {% endif %}
          {{ content.w3css_content_body }}
        </div>

      {% if w3css_link %}
      </a>
      {% endif %}
    </div>

  </div>
{% endblock %}
