use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\w3css_paragraphs\Hook\W3cssParagraphsHooks;
use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function w3css_paragraphs_help($route_name, RouteMatchInterface $route_match) {
  return \Drupal::service(W3cssParagraphsHooks::class)->help($route_name, $route_match);
}

/**
 * Implements hook_preprocess_page().
 */
#[LegacyHook]
function w3css_paragraphs_preprocess_page(&$variables) {
  \Drupal::service(W3cssParagraphsHooks::class)->preprocessPage($variables);
}

/**
 * Implements hook_theme().
 */
#[LegacyHook]
function w3css_paragraphs_theme($existing, $type, $theme, $path) {
  return \Drupal::service(W3cssParagraphsHooks::class)->theme($existing, $type, $theme, $path);
}
