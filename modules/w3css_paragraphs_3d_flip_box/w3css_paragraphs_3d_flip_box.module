 * Primary module hooks for W3CSS Paragraphs 3D Flip Box.
 */

declare(strict_types=1);

/**
 * @file
 * W3CSS Paragraphs 3D Flip Box.
 *
 * Filename:     w3css_paragraphs_3d_flip_box.module
 * Website:      https://www.flashwebcenter.com
