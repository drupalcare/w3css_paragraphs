use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\w3css_paragraphs_slideshow\Hook\W3cssParagraphsSlideshowHooks;
use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function w3css_paragraphs_slideshow_help($route_name, RouteMatchInterface $route_match) {
  return \Drupal::service(W3cssParagraphsSlideshowHooks::class)->help($route_name, $route_match);
}

/**
 * Implements hook_theme().
 */
#[LegacyHook]
function w3css_paragraphs_slideshow_theme($existing, $type, $theme, $path) {
  return \Drupal::service(W3cssParagraphsSlideshowHooks::class)->theme($existing, $type, $theme, $path);
}
