{
    "name": "drupal/w3css_paragraphs",
    "description": "A comprehensive suite of pre-configured Paragraph bundles built with the W3.CSS framework for rapid content creation.",
    "type": "drupal-module",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/w3css_paragraphs",
    "authors": [
        {
            "name": "Alaa Haddad",
            "email": "alaa@flashwebcenter.com",
            "homepage": "https://alaahaddad.com",
            "role": "Maintainer"
        },
        {
            "name": "Flash Web Center LLC",
            "homepage": "https://flashwebcenter.com",
            "role": "Organization"
        }
    ],
    "support": {
        "issues": "https://www.drupal.org/project/issues/w3css_paragraphs",
        "source": "https://git.drupalcode.org/project/w3css_paragraphs",
        "docs": "https://www.drupal.org/docs/contributed-modules/w3css_paragraphs"
    },
    "require": {
        "php": ">=8.3",
        "drupal/core": "^11.3 || ^12",
        "drupal/entity_reference_revisions": "^1.12",
        "drupal/field_group": "^3.6 || ^4",
        "drupal/paragraphs": "^1.17"
    },
    "conflict": {
        "drupal/d8w3css": "<3.0"
    },
    "suggest": {
        "drupal/d8w3css": "W3CSS Theme 3.x: the module is built for it"
    },
    "require-dev": {
        "drupal/core-dev": "^11.3 || ^12"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "drupal/core-composer-scaffold": true,
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
