{#
/**
* @file
* Default theme implementation to display a paragraph.
*
* Available variables:
* - paragraph: Full paragraph entity.
*   Only method names starting with "get", "has", or "is" and a few common
*   methods such as "id", "label", and "bundle" are available. For example:
*   - paragraph.getCreatedTime() will return the paragraph creation timestamp.
*   - paragraph.id(): The paragraph ID.
*   - paragraph.bundle(): The type of the paragraph, for example, "image" or "text".
*   - paragraph.getOwnerId(): The user ID of the paragraph author.
*   See Drupal\paragraphs\Entity\Paragraph for a full list of public properties
*   and methods for the paragraph object.
* - content: All paragraph items. Use {{ content }} to print them all,
*   or print a subset such as {{ content.field_example }}. Use
*   {{ content|without('field_example') }} to temporarily suppress the printing
*   of a given child element.
* - attributes: HTML attributes for the containing element.
*   The attributes.class element may contain one or more of the following
*   classes:
*   - paragraphs: The current template type (also known as a "theming hook").
*   - paragraphs--type-[type]: The current paragraphs type. For example, if the paragraph is an
*     "Image" it would result in "paragraphs--type--image". Note that the machine
*     name will often be in a short form of the human readable label.
*   - paragraphs--view-mode--[view_mode]: The View Mode of the paragraph; for example, a
*     preview would result in: "paragraphs--view-mode--preview", and
*     default: "paragraphs--view-mode--default".
* - view_mode: View mode; for example, "preview" or "full".
* - logged_in: Flag for authenticated user status. Will be true when the
*   current user is a logged-in member.
* - is_admin: Flag for admin user status. Will be true when the current user
*   is an administrator.
*
* @see template_preprocess_paragraph()
*
* @ingroup themeable
#}
{% extends '@w3css_paragraphs/w3css-paragraph-base.html.twig' %}
{# Wrapper, option classes and spacing come from the base and W3cssPreprocessHooks. #}

{% set w3css_id_prefix = 'w3-slideshow-' %}
{% set w3css_inner_id = false %}
{% set w3css_animated_tab = w3css_display.animated_tab|default('') %}
{% set w3css_display_active = w3css_display.active_item|default('') %}
{% set w3css_wrapper_extra = w3css_display_active ? [w3css_display_active] : [] %}

{# prev_next and bottom_nav are booleans, slide_play_stop a list_integer: read as printed. #}
{% if content.w3css_display_prev_next|render %}
  {% set w3css_prev_next = content.w3css_display_prev_next|render|striptags|trim %}
{% endif %}

{% if content.w3css_display_bottom_nav|render %}
  {% set w3css_bottom_nav = content.w3css_display_bottom_nav|render|striptags|trim %}
{% endif %}

{% if content.w3css_display_slide_play_stop|render %}
  {% set w3css_display_slide_play_stop = content.w3css_display_slide_play_stop|render|striptags|trim %}
{% endif %}

{% if w3css_display_slide_play_stop == '' %}
  {% set w3css_display_slide_play_stop = 0 %}
{% endif %}

{% set slide_total = paragraph.w3css_content_slideshow_section|length %}

{% block w3css_libraries %}
{{ attach_library('w3css_paragraphs_slideshow/w3css-paragraphs-slideshow') }}
{% endblock %}

{% block w3css_content %}
      {% if content.w3css_content_title|render %}
      <{{ content_title_tag }} class="content-title">{{ content.w3css_content_title }}</{{ content_title_tag }}>
      {% endif %}

      <div id="{{ paragraph_id }}" class="w3-slideshow-inner w3css-slideshow" role="region" aria-roledescription="{{ 'carousel'|t }}" aria-label="{{ content.w3css_content_title|render|striptags|trim ?: 'Slideshow'|t }}">
        <div id="w3-slides-{{ paragraph.id.value }}" class="w3-slides w3css-slideshow__slides">
        {% for key, item in content.w3css_content_slideshow_section %}
        {% if key|first != '#' %}
        <div id="w3-s-wr-{{ paragraph.id.value }}-{{ key + 1 }}" class="w3-row w3-s-wr w3css-slideshow__slide" role="group" aria-roledescription="{{ 'slide'|t }}" aria-label="{{ '@number of @total'|t({'@number': key + 1, '@total': slide_total}) }}">

          <div class="w3-row w3-s-pane w3css-slideshow__pane">
            {# Loop through all of the slideshow section bodies. #}
            <div class="w3-s-pane w3css-slideshow__panel{{ w3css_animated_tab == '' ? '' : ' ' ~ w3css_animated_tab }}"
                 id="{{ paragraph_id }}-{{ key + 1 }}-pane">
              {% for body_key, body_item in item['#paragraph'].w3css_content_slideshow_body %}
                {# Use the same render array as item and set the '#paragraph'. #}
                {% set section_body = item %}
                {% set lang = section_body['#paragraph'].langcode[0].value %}
                {# Check if a translation exists #}
                {% if section_body['#paragraph'].w3css_content_slideshow_body[body_key].entity.hasTranslation(lang) %}
                  {# Load the entity for the current translation #}
                  {% set section_translation = section_body['#paragraph'].w3css_content_slideshow_body[body_key].entity.getTranslation(lang) %}
                {% else %}
                  {# Load the source entity #}
                  {% set section_translation = section_body['#paragraph'].w3css_content_slideshow_body[body_key].entity %}
                {% endif %}
                {% set section_body = section_body|merge({'#paragraph': section_translation}) %}
                {# Remove the cache keys so it doesn't repeat the first value. #}
                {% set section_body = section_body|merge({'#cache': {}}) %}
                {# Print the compiled section body. #}
                {{ section_body }}
              {% endfor %}
            </div>

            <div class="w3-row w3-s-title w3css-slideshow__title">
              {{ item['#paragraph'].w3css_content_slideshow_title.value }}
            </div>

          </div>

        </div>
        {% endif %}
        {% endfor %}
        </div>

          <div id="w3-s-nav-{{ paragraph.id.value }}" class="w3-bar w3-center w3-s-nav btns-{{ w3css_bottom_nav }} w3css-slideshow__nav{{ w3css_bottom_nav ? ' w3css-slideshow__nav--' ~ w3css_bottom_nav|lower }}">
            <button type="button" id="btn-{{ paragraph.id.value }}" class="w3-button pp play-active-slideshow w3css-slideshow__toggle w3css-slideshow__toggle--playing" aria-label="{{ 'Pause slideshow'|t }}">&#10073;&nbsp;&#10073;</button>
            {% for key, item in content.w3css_content_slideshow_section %}
            {% if key|first != '#' %}
            <button type="button" id="b-nav-{{ paragraph.id.value }}-{{ key + 1 }}" class="w3-button b-nav w3css-slideshow__nav-button{% if key == 0 %} w3-is-active w3css-slideshow__nav-button--active{% endif %}" aria-label="{{ 'Go to slide @number'|t({'@number': key + 1}) }}"{% if key == 0 %} aria-current="true"{% endif %}>
              {{ key + 1 }}
            </button>
            {% endif %}
            {% endfor %}
          </div>

        <div id="w3-s-np-{{ paragraph.id.value }}" class="w3-bar w3-s-np btns-{{ w3css_prev_next }} w3css-slideshow__arrows{{ w3css_prev_next ? ' w3css-slideshow__arrows--' ~ w3css_prev_next|lower }}">
          <button type="button" class="w3-s-prev w3-button w3-left w3-button w3css-slideshow__arrow w3css-slideshow__arrow--prev" aria-label="{{ 'Previous slide'|t }}">&#10094;</button>
          <button type="button" class="w3-s-next w3-button w3-right w3css-slideshow__arrow w3css-slideshow__arrow--next" aria-label="{{ 'Next slide'|t }}">&#10095;</button>
        </div>

        <div class="play-stop-value w3css-slideshow__interval" aria-hidden="true">{{ w3css_display_slide_play_stop }}</div>

      </div>{# id #}
{% endblock %}
