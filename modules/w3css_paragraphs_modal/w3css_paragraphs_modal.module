use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\w3css_paragraphs_modal\Hook\W3cssParagraphsModalHooks;
use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function w3css_paragraphs_modal_help($route_name, RouteMatchInterface $route_match) {
  return \Drupal::service(W3cssParagraphsModalHooks::class)->help($route_name, $route_match);
}

/**
 * Implements hook_theme().
 */
#[LegacyHook]
function w3css_paragraphs_modal_theme($existing, $type, $theme, $path) {
  return \Drupal::service(W3cssParagraphsModalHooks::class)->theme($existing, $type, $theme, $path);
}
