<?php

/**
 * @file
 * Primary module hooks for W3CSS Paragraphs.
 */

declare(strict_types=1);

/**
 * @file
 * W3CSS Paragraphs.
 *
 * Filename:     w3css_paragraphs.module
 * Website:      https://www.flashwebcenter.com
 * Description:  template.
 * Developer:    Alaa Haddad https://www.alaahaddad.com.
