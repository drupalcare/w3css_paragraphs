/**
 * Implements hook_update_N().
 */
function w3css_paragraphs_3d_carousel_update_9004(): void {
  _w3css_paragraphs_3d_carousel_update_third_party_from_yml('entity_form_display',
    'paragraph.w3css_3d_carousel.default', 'field_group', 'w3css_tab_display');
  \Drupal::messenger()->addMessage('A new field was added to play and stop the 3D slides');
}

/**
 * Corrects a null drag-drop setting on the carousel body field.
 */
function w3css_paragraphs_3d_carousel_update_9005(): void {
  // Earlier releases shipped target_bundles_drag_drop empty, which stores NULL
  // and fails the config schema (a sequence is expected). Only a stored NULL is
  // changed, to the empty sequence; any other value is left as the site has it.
  $field = \Drupal::entityTypeManager()
    ->getStorage('field_config')
    ->load('paragraph.w3css_3d_carousel.w3css_content_3d_car_body');
  if ($field === NULL) {
    return;
  }
  $settings = $field->getSettings();
  if (!array_key_exists('handler_settings', $settings)
    || !is_array($settings['handler_settings'])
    || !array_key_exists('target_bundles_drag_drop', $settings['handler_settings'])
    || $settings['handler_settings']['target_bundles_drag_drop'] !== NULL) {
    return;
  }
  $settings['handler_settings']['target_bundles_drag_drop'] = [];
  $field->set('settings', $settings);
  $field->save();
}
