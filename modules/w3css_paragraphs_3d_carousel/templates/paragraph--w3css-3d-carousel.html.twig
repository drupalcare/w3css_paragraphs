{#
/**
 * @file
 * Theme implementation for the w3css_3d_carousel paragraph.
 *
 * Extends the shared wrapper; see w3css-paragraph-base.html.twig for the
 * variables built in PHP and the blocks a child can fill.
 *
 * Available variables:
 * - paragraph: Full paragraph entity.
 * - content: All paragraph items.
 * - attributes: HTML attributes for the containing element.
 * - view_mode: View mode; for example, "preview" or "full".
 * - content_title_tag: Heading element for the content title.
 * - w3css_display_3d_play_stop: Autoplay interval; 0 when unset.
 * - w3css_title_over_image: " title-over-image" when the title sits over
 *   the image.
 *
 * @see template_preprocess_paragraph()
 * @see \Drupal\w3css_paragraphs\Hook\W3cssPreprocessHooks
 *
 * @ingroup themeable
 */
#}
{% extends '@w3css_paragraphs/w3css-paragraph-base.html.twig' %}

{% set w3css_id_prefix = 'w3-3d-carousel-' %}
{% set w3css_wrapper_box = false %}

{# play_stop is a list_integer and title_over a boolean: read as printed. #}
{% if content.w3css_display_3d_play_stop|render %}
  {% set w3css_display_3d_play_stop = content.w3css_display_3d_play_stop|render|striptags|trim %}
{% endif %}

{% if w3css_display_3d_play_stop == '' %}
  {% set w3css_display_3d_play_stop = 0 %}
{% endif %}

{% if content.w3css_display_title_over|render %}
  {% set title_over_image = content.w3css_display_title_over|render|striptags|trim %}
    {% if title_over_image == 'On' %}
      {% set w3css_title_over_image = ' title-over-image' %}
    {% endif %}
{% endif %}

{% set w3css_lheight = content.w3css_content_3dcar_lheight|render|striptags|trim %}
{% set w3css_lheight = 'w3-3d-car-' ~ w3css_lheight %}
{% set w3css_wrapper_extra = w3css_class_groups.box_base|merge([w3css_lheight]) %}

{% if content.w3css_content_3dcar_sheight|render %}
  {% set w3css_sheight = content.w3css_content_3dcar_sheight|render|striptags|trim %}
  {% set w3css_sheight = 'w3-3d-car-s-' ~ w3css_sheight %}
  {% set w3css_wrapper_extra = w3css_wrapper_extra|merge([w3css_sheight]) %}
{% endif %}

{% block w3css_libraries %}
{{ attach_library('w3css_paragraphs_3d_carousel/w3css-paragraphs-3d-carousel') }}
{% endblock %}

{% block w3css_inner %}
{% set co_id = 'co-' ~ paragraph.id.value %}
{% set slide_total = paragraph.w3css_content_3d_car_body|length %}
  <div class="w3-row p-container-inner w3css-3d-carousel" role="region" aria-roledescription="{{ 'carousel'|t }}" aria-label="{{ content.w3css_content_title|render|striptags|trim ?: 'Carousel'|t }}">
    {% if content.w3css_content_title|render %}
    <{{ content_title_tag }} class="content-title">{{ content.w3css_content_title }}</{{ content_title_tag }}>
    {% endif %}
    <div id="{{ paragraph_id }}" class="w3-3d-carousel w3css-3d-carousel__ring">
      {% for key, item in content.w3css_content_3d_car_body %}
      {% if key|first != '#' %}
      <div class="w3-carousel-item item-{{ key + 1 }}{{ w3css_title_over_image }} w3css-3d-carousel__item{{ w3css_title_over_image ? ' w3css-3d-carousel__item--title-over' }}" role="group" aria-roledescription="{{ 'slide'|t }}" aria-label="{{ '@number of @total'|t({'@number': key + 1, '@total': slide_total}) }}">{{ item }}</div>
      {% endif %}
      {% endfor %}
    </div>
    <div id="{{ co_id }}" class="carousel-options w3css-3d-carousel__options">
      <div class="w3-row w3css-3d-carousel__controls">
        <button type="button" id="prev-{{ paragraph.id.value }}" class="w3-button previous-button w3css-3d-carousel__arrow w3css-3d-carousel__arrow--prev" aria-label="{{ 'Previous slide'|t }}">&#10094;</button>
        <span id="index-{{ paragraph.id.value }}" class="slide-number w3css-3d-carousel__index"></span>
        <button type="button" id="btn-{{ paragraph.id.value }}" class="w3-button pp play-active-carousel w3css-3d-carousel__toggle w3css-3d-carousel__toggle--playing" aria-label="{{ 'Pause carousel'|t }}">&#10073;&nbsp;&#10073;</button>
        <button type="button" id="next-{{ paragraph.id.value }}" class="w3-button next-button w3css-3d-carousel__arrow w3css-3d-carousel__arrow--next" aria-label="{{ 'Next slide'|t }}">&#10095;</button>
      </div>
    <div class="play-stop-value w3css-3d-carousel__interval" aria-hidden="true">{{ w3css_display_3d_play_stop }}</div>
    </div>
  </div>
{% endblock %}
