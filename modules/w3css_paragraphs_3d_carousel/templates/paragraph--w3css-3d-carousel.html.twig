{#
/**
* @file
* Default theme implementation to display a paragraph.
*
* Available variables:
* - paragraph: Full paragraph entity.
*   Only method names starting with "get", "has", or "is" and a few common
*   methods such as "id", "label", and "bundle" are available. For example:
*   - paragraph.getCreatedTime() will return the paragraph creation timestamp.
*   - paragraph.id(): The paragraph ID.
*   - paragraph.bundle(): The type of the paragraph, for example, "image" or "text".
*   - paragraph.getOwnerId(): The user ID of the paragraph author.
*   See Drupal\paragraphs\Entity\Paragraph for a full list of public properties
*   and methods for the paragraph object.
* - content: All paragraph items. Use {{ content }} to print them all,
*   or print a subset such as {{ content.field_example }}. Use
*   {{ content|without('field_example') }} to temporarily suppress the printing
*   of a given child element.
* - attributes: HTML attributes for the containing element.
*   The attributes.class element may contain one or more of the following
*   classes:
*   - paragraphs: The current template type (also known as a "theming hook").
*   - paragraphs--type-[type]: The current paragraphs type. For example, if the paragraph is an
*     "Image" it would result in "paragraphs--type--image". Note that the machine
*     name will often be in a short form of the human readable label.
*   - paragraphs--view-mode--[view_mode]: The View Mode of the paragraph; for example, a
*     preview would result in: "paragraphs--view-mode--preview", and
*     default: "paragraphs--view-mode--default".
* - view_mode: View mode; for example, "preview" or "full".
* - logged_in: Flag for authenticated user status. Will be true when the
*   current user is a logged-in member.
* - is_admin: Flag for admin user status. Will be true when the current user
*   is an administrator.
*
* @see template_preprocess_paragraph()
*
* @ingroup themeable
#}

{{ attach_library('w3css_paragraphs/w3css-paragraphs') }}
{{ attach_library('w3css_paragraphs_3d_carousel/w3css-paragraphs-3d-carousel') }}

{% set classes = [
  'w3-row',
  'p-container',
  'paragraph',
  'paragraph--type--' ~ paragraph.bundle|clean_class,
  view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
  not paragraph.isPublished() ? 'paragraph--unpublished',
  'paragraph--id--' ~ paragraph.id.value
] %}

{# Merge display features into classes. #}
{% set w3css_displays = [
  'w3css_display_hover_bg',
  'w3css_display_text_color',
  'w3css_display_hover_text',
  'w3css_display_border',
  'w3css_display_round',
  'w3css_display_border_color',
  'w3css_display_card',
  'w3css_display_hover_border'
] %}

{% for w3css_display in w3css_displays %}
  {% if content[w3css_display]|render %}
    {% set classes = classes|merge([content[w3css_display]|render|striptags|trim]) %}
  {% endif %}
{% endfor %}

{# Get the paragraph width. #}
{% set container_w_input = content.w3css_display_width|render|striptags|trim %}
{% if container_w_input %}
  {% set container_width = 'p-container-width-' ~ container_w_input %}
  {% set classes = classes|merge([container_width]) %}
{% endif %}

{# Get the paragraph backgournd/opcity . #}
{% set w3css_bg_color = content.w3css_display_bg_color|render|striptags|trim|slice(3)|replace({'-': ','}) %}
{% set w3css_bg_opacity = content.w3css_display_opacity|render|striptags|trim|default('100') %}
{% if w3css_bg_color %}
  {% set w3css_bg_opacity = w3css_bg_opacity != '100' ? '0.' ~ w3css_bg_opacity : w3css_bg_opacity %}
  {% set w3css_bg_color = w3css_bg_color ~ ',' ~  w3css_bg_opacity %}
{% endif %}

{# margin and padding only for child div #}
{% set w3css_margin_padding = '' %}
{% set w3css_margin = content.w3css_display_margin|render|striptags|trim %}
{% set w3css_padding = content.w3css_display_padding|render|striptags|trim %}

{% if w3css_margin %}
  {% set w3css_margin_padding = w3css_margin %}
{% endif %}

{% if w3css_padding %}
  {% set w3css_margin_padding = w3css_margin_padding ~ ' ' ~ w3css_padding %}
{% endif %}
{# End of margin and height #}
{% set w3css_display_3d_play_stop = content.w3css_display_3d_play_stop|render|striptags|trim|default(0) %}

{% set title_over_image = content.w3css_display_title_over|render|striptags|trim %}
{% if title_over_image == 'On' %}
  {% set w3css_title_over_image  = ' title-over-image' %}
{% endif %}

{% set w3css_lheight = content.w3css_content_3dcar_lheight|render|striptags|trim %}
{% if w3css_lheight %}
  {% set w3css_lheight  = 'w3-3d-car-' ~ w3css_lheight %}
  {% set classes = classes|merge([w3css_lheight]) %}
{% endif %}

{% set w3css_sheight = content.w3css_content_3dcar_sheight|render|striptags|trim %}
{% if w3css_sheight %}
  {% set w3css_sheight  = 'w3-3d-car-s-' ~ w3css_sheight %}
  {% set classes = classes|merge([w3css_sheight]) %}
{% endif %}

{% set paragraph_id  = 'w3-3d-carousel-' ~ paragraph.id.value %}
{% set co_id  = 'co-' ~ paragraph.id.value %}
<div {% if w3css_bg_color %}style="background-color: rgba( {{ w3css_bg_color }} )" {% endif %} {{ attributes.addClass(classes) }}>
  <div class="w3-row p-container-inner">
    {% if content.w3css_content_title|render %}
    <h3 class="content-title">{{ content.w3css_content_title }}</h3>
    {% endif %}
    <div id="{{ paragraph_id }}" class="w3-3d-carousel">
      {% for key, item in content.w3css_content_3d_car_body %}
      {% if key|first != '#' %}
      <div class="w3-carousel-item item-{{ key + 1 }} {{ w3css_title_over_image }}">{{ item }}</div>
      {% endif %}
      {% endfor %}
    </div>
    <div id="{{ co_id }}" class="carousel-options">
      <div class="w3-row">
        <button id="prev-{{ paragraph.id.value }}" class="w3-button previous-button">&#10094;</button>
        <span id="index-{{ paragraph.id.value }}" class="slide-number"></span>
        <button id="btn-{{ paragraph.id.value }}" class="w3-button pp play-active-carousel">&#10073;&nbsp;&#10073;</button>
        <button id="next-{{ paragraph.id.value }}" class="w3-button next-button">&#10095;</button>
      </div>
    <div class="play-stop-value">{{ w3css_display_3d_play_stop }}</div>
    </div>
  </div>
</div> {# End of main wrapper #}

