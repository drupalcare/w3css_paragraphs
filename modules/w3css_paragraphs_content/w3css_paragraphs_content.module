/**
 * Implements hook_preprocess_page() for page templates.
 */
#[LegacyHook]
function w3css_paragraphs_content_preprocess_page(&$variables) {
  \Drupal::service(W3cssParagraphsContentHooks::class)->preprocessPage($variables);
}

/**
 * Implements hook_theme().
 */
#[LegacyHook]
function w3css_paragraphs_content_theme($existing, $type, $theme, $path) {
  return \Drupal::service(W3cssParagraphsContentHooks::class)->theme($existing, $type, $theme, $path);
}
