{#
/**
 * @file
 * Theme implementation for the w3css_card paragraph.
 *
 * Extends the shared wrapper; see w3css-paragraph-base.html.twig for the
 * variables built in PHP and the blocks a child can fill.
 *
 * Available variables:
 * - paragraph: Full paragraph entity.
 * - content: All paragraph items.
 * - attributes: HTML attributes for the containing element.
 * - view_mode: View mode; for example, "preview" or "full".
 * - content_title_tag: Heading element for the content title.
 * - w3css_link, w3css_link_title_attr: The link field, set by the base.
 * - w3css_card_layout, side_l, side_r: The layout option and its columns.
 *
 * @see template_preprocess_paragraph()
 * @see \Drupal\w3css_paragraphs\Hook\W3cssPreprocessHooks
 *
 * @ingroup themeable
 */
#}
{% extends '@w3css_paragraphs/w3css-paragraph-base.html.twig' %}

{% set w3css_id_prefix = 'w3-card-' %}

{% block w3css_libraries %}
{{ attach_library('w3css_paragraphs_card/w3css-paragraphs-card') }}
{% endblock %}

{% block w3css_content %}
{# The wrapper link covers the whole card (title, image and body). If the body has its own link, the wrapper link covers only the image, because links cannot nest. #}
{% set w3css_card_layout = w3css_display.card_layout|default('') %}
{# Columns per layout: [left side, right side]. #}
{% set w3css_card_sides = {
  left25: ['w3-quarter', 'w3-threequarter'],
  left33: ['w3-third', 'w3-twothird'],
  left50: ['w3-half', 'w3-half'],
  left67: ['w3-twothird', 'w3-third'],
  left75: ['w3-threequarter', 'w3-quarter'],
  right25: ['w3-quarter', 'w3-threequarter'],
  right33: ['w3-third', 'w3-twothird'],
  right50: ['w3-half', 'w3-half'],
  right67: ['w3-twothird', 'w3-third'],
  right75: ['w3-threequarter', 'w3-quarter'],
} %}
{% set side_l = w3css_card_sides[w3css_card_layout][0]|default('') %}
{% set side_r = w3css_card_sides[w3css_card_layout][1]|default('') %}

{# Check if the body has a link #}
{% set has_link = content.w3css_content_body|render|raw %}
{% set has_link = has_link|split('</a>') %}

      {# Image on the left or image on the top #}
      {% if w3css_card_layout in ['', 'left25', 'left33', 'left50', 'left67', 'left75'] %}

      {% if w3css_link and has_link|length < 2 %}
        <a href="{{ w3css_link }}" class="w3-row w3css-link" {% if w3css_link_title_attr %} title="{{ w3css_link_title_attr }}" {% endif %}>
      {% endif %}
        <div class="{{ side_l }} card-image {{ w3css_card_layout }}">
        {% if w3css_link and has_link|length > 1 %}
          <a href="{{ w3css_link }}" class="w3-row w3css-link" {% if w3css_link_title_attr %} title="{{ w3css_link_title_attr }}" {% endif %}>
        {% endif %}
          {{ content.w3css_content_image }}
        {% if w3css_link and has_link|length > 1 %}</a>{% endif %}
        </div>
        <div class="{{ side_r }} card-text {{ w3css_card_layout }}">
          {% if content.w3css_content_title|render %}
            <{{ content_title_tag }} class="content-title">{{ content.w3css_content_title }}</{{ content_title_tag }}>
          {% endif %}
          {{ content.w3css_content_body }}
        </div>
      {% if w3css_link and has_link|length < 2 %}</a>{% endif %}
      {% endif %}

      {# Image on the right #}
      {% if w3css_card_layout in ['right25', 'right33', 'right50', 'right67', 'right75'] %}

      {% if w3css_link and has_link|length < 2 %}
        <a href="{{ w3css_link }}" class="w3-row w3css-link" {% if w3css_link_title_attr %} title="{{ w3css_link_title_attr }}" {% endif %}>
      {% endif %}
        <div class="{{ side_l }} card-text {{ w3css_card_layout }}">
          {% if content.w3css_content_title|render %}
            <{{ content_title_tag }} class="content-title">{{ content.w3css_content_title }}</{{ content_title_tag }}>
          {% endif %}
          {{ content.w3css_content_body }}
        </div>
        <div class="{{ side_r }} card-image {{ w3css_card_layout }}">
        {% if w3css_link and has_link|length > 1 %}
          <a href="{{ w3css_link }}" class="w3-row w3css-link" {% if w3css_link_title_attr %} title="{{ w3css_link_title_attr }}" {% endif %}>
        {% endif %}
          {{ content.w3css_content_image }}
        {% if w3css_link and has_link|length > 1 %}</a>{% endif %}
        </div>
      {% if w3css_link and has_link|length < 2 %}</a>{% endif %}
      {% endif %}
{% endblock %}
