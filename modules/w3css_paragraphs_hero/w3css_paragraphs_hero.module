use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\w3css_paragraphs_hero\Hook\W3cssParagraphsHeroHooks;
use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function w3css_paragraphs_hero_help($route_name, RouteMatchInterface $route_match) {
  return \Drupal::service(W3cssParagraphsHeroHooks::class)->help($route_name, $route_match);
}

/**
 * Implements hook_theme().
 */
#[LegacyHook]
function w3css_paragraphs_hero_theme($existing, $type, $theme, $path) {
  return \Drupal::service(W3cssParagraphsHeroHooks::class)->theme($existing, $type, $theme, $path);
}
