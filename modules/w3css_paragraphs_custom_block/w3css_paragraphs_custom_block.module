use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\w3css_paragraphs_custom_block\Hook\W3cssParagraphsCustomBlockHooks;
use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function w3css_paragraphs_custom_block_help($route_name, RouteMatchInterface $route_match) {
  return \Drupal::service(W3cssParagraphsCustomBlockHooks::class)->help($route_name, $route_match);
}

/**
 * Implements hook_theme().
 */
#[LegacyHook]
function w3css_paragraphs_custom_block_theme($existing, $type, $theme, $path) {
  return \Drupal::service(W3cssParagraphsCustomBlockHooks::class)->theme($existing, $type, $theme, $path);
}
