use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\w3css_paragraphs_contact_form\Hook\W3cssParagraphsContactFormHooks;
use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function w3css_paragraphs_contact_form_help($route_name, RouteMatchInterface $route_match) {
  return \Drupal::service(W3cssParagraphsContactFormHooks::class)->help($route_name, $route_match);
}
