use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\w3css_paragraphs_3d_flip_box\Hook\W3cssParagraphs3dFlipBoxHooks;
use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function w3css_paragraphs_3d_flip_box_help($route_name, RouteMatchInterface $route_match) {
  return \Drupal::service(W3cssParagraphs3dFlipBoxHooks::class)->help($route_name, $route_match);
}

/**
 * Implements hook_theme().
 */
#[LegacyHook]
function w3css_paragraphs_3d_flip_box_theme($existing, $type, $theme, $path) {
  return \Drupal::service(W3cssParagraphs3dFlipBoxHooks::class)->theme($existing, $type, $theme, $path);
}
